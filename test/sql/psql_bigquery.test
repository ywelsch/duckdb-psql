# name: test/sql/psql_bigquery.test
# description: BigQuery pipe syntax, using the examples of its documentation where DuckDB SQL has no shorter native form
# group: [sql]

require psql

statement ok
PRAGMA enable_verification

statement ok
CALL psql_enable();

statement ok
CREATE TABLE produce AS FROM (VALUES ('apples', 'fruit', 2), ('carrots', 'vegetable', 8), ('apples', 'fruit', 7), ('bananas', 'fruit', 5)) v(item, category, sales);

# EXTEND
query TTIT
from produce |> extend item in ('bananas', 'lemons') as is_yellow |> order by all;
----
apples	fruit	2	false
apples	fruit	7	false
bananas	fruit	5	true
carrots	vegetable	8	false

query I
from produce |> extend sum(sales) over () as total_sales |> select distinct total_sales;
----
22

query TI
from produce |> extend sum(sales) over item_window as category_total window item_window as (partition by category) |> select item, category_total order by all;
----
apples	14
apples	14
bananas	14
carrots	8

query I
from produce |> extend sales * 2 as doubled |> extend doubled + 1 as more |> select max(more);
----
17

# SET
query II
select 1 as x, 11 as y union all select 2, 22 |> set x = x * x, y = 3 |> order by all;
----
1	3
4	3

statement error
from produce |> set nope = 1;
----
nope

# DROP
query T
select 'apples' as item, 2 as sales, 'fruit' as category |> drop sales, category;
----
apples

statement error
from produce |> drop nope;
----
nope

# RENAME
query II
select 1 as x, 2 as y |> rename x as a, y b |> select a, b;
----
1	2

# DISTINCT
query T
from produce |> select category |> distinct |> order by all;
----
fruit
vegetable

# AS names the input of the following stages
query III
select '000456' as id, 5 as sales |> select id, sum(sales) as total_sales group by id |> as t1 |> join (select 456 as id, 'yellow' as color) as t2 on cast(t1.id as integer) = t2.id select t2.id, total_sales, color;
----
456	5	yellow

query I
select 1 as a, 2 as b |> as t |> where t.a = 1 |> extend t.a + t.b as c |> select t.c;
----
3

# set operations
query I
select 1 as n |> union all (select 1) |> order by all;
----
1
1

query I
select 1 as n |> union distinct (select 1) |> order by all;
----
1

query II
select 1 as one_digit, 10 as two_digit |> union all by name (select 20 as two_digit, 2 as one_digit) |> order by all;
----
1	10
2	20

query I
select * from (values (1), (2), (3)) v(x) |> intersect distinct (select 2);
----
2

query I
select * from (values (1), (2), (3)) v(x) |> except distinct (select 1) |> order by all;
----
2
3

# TABLESAMPLE
query I
from produce |> tablesample system (100 percent) |> select count(*);
----
4

# PIVOT and UNPIVOT
query II
from produce |> select item, sales |> pivot (sum(sales) as total for item in ('apples', 'bananas'));
----
9	5

query TI
select 1 as q1, 2 as q2 |> unpivot (sales for quarter in (q1, q2)) |> order by all;
----
q1	1
q2	2

# |> ends an expression, so an operator can follow a stage that ends with one
query II
select 2 as x, 3 |> set x = 4;
----
4	3

# the operator keywords are not reserved
query I
select 1 as a |> extend select extend.a;
----
1

query II
select 1 as set, 2 as drop |> select set, drop;
----
1	2
